2️⃣ application.yml (SECURE KEY HANDLING)

👉 No private keys stored
Azure public keys are fetched automatically via JWKS.

server:
  port: 8080

spring:
  datasource:
    url: jdbc:h2:mem:testdb
    driver-class-name: org.h2.Driver
    username: sa
    password:

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true

  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: https://login.microsoftonline.com/<TENANT_ID>/v2.0
          audiences:
            - <CLIENT_ID>


